# MonshinMate environment variables sample
# `.env` にコピーして docker compose / dev.sh から読み込ませてください。

# ===== 基本設定 =====
MONSHINMATE_ENV=local
PERSISTENCE_BACKEND=sqlite
# 今回の運用指定: パスワードのみ。既存MFAや登録必須状態は迂回しません。
MONSHINMATE_ADMIN_REQUIRE_MFA=0
# 固定の初期/非常用パスワードによる認証は廃止されています。
# 現パスワード継承は internal_docs/admin_system_setup.md のオフライン移行を参照。
# 本番/Composeでは独立した強いキーを起動前に注入。既存TOTP鍵を再生成しないこと。
#SECRET_KEY=
#TOTP_ENC_KEY=
#LLM_API_KEY=

# ===== SQLite（Docker 共有ボリューム想定）=====
# Docker Compose 実行時は compose 側で `/app/data/sqlite/app.sqlite3` が自動設定されます。
# ローカルから直接起動する場合にのみ、絶対パスで上書きしてください。
#MONSHINMATE_DB=C:/path/to/monshinmate.sqlite3

# ===== CouchDB =====
#COUCHDB_URL=http://couchdb:5984/
#COUCHDB_DB=monshin_sessions
#COUCHDB_USER=
#COUCHDB_PASSWORD=

# Cloud Run/Firestoreの設定は private/cloud-run-adapter/README.md を参照。
# 起動後の秘密情報ローダーや環境変数の管理者パスワードに依存しません。

# ===== ストレージ =====
FILE_STORAGE_BACKEND=local

# ===== フロントエンド =====
FRONTEND_HTTP_PORT=5173
#ALLOWED_HOSTS=localhost
#VITE_ALLOWED_HOSTS=localhost

# ===== CORS / オリジン =====
#FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
